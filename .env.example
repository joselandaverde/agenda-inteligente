# Variables de configuración por ambiente (bloque 0-B).
# Copia este archivo como ".env.local" para desarrollo local. ".env.local" no
# se versiona. En Vercel se cargan en Settings > Environment Variables, con un
# valor para Production y otro para Preview.
#
# NUNCA pongas aquí ni en el repositorio una llave secreta (sb_secret_...,
# service_role) ni la llave del AI Gateway.

# Dirección del proyecto de Supabase de ESTE ambiente.
REACT_APP_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave PÚBLICA (publishable / anon) del mismo proyecto.
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Nombre de la base que usa este ambiente: "produccion" o "pruebas".
# La franja superior de la app lo muestra.
REACT_APP_BASE_DATOS=pruebas

# Solo en Vercel (nunca en archivos): llave del AI Gateway de este ambiente.
# AI_GATEWAY_API_KEY=
# Opcional: interpretaciones por hora por usuario (por defecto 30).
# AI_LIMITE_POR_HORA=30
